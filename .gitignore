# Dependencies
node_modules/

# Agent reference material (examples/ = inspiration for the agent, not shipped code)
examples/

# Build outputs
dist/
dist-bundle/
build/
out/
storybook-static/
*.tsbuildinfo
# Runtime plugin bundles (generated by `pnpm build:plugins`, never committed)
apps/desktop/public/plugins/

# Tauri / Rust
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/binaries/

# Environment
.env
.env.local
.env.*.local
!env.example
!.env.example

# Local-first data (runtime artifacts, never committed)
*.sqlite
*.sqlite3
*.db
.vorynth-backup
data/

# IDE / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test coverage
coverage/
.nyc_output/

# Varynth local backups
*.bak

#.zcode
.zcode/plans/

# Signing keys — never commit. The updater private key (vorynth.key) is the
# release signing secret; the .pub file is committed via tauri.conf.json.
apps/desktop/src-tauri/.tauri/

# CI marker — the release workflow touches this after downloading the shared
# web artifact so `cargo tauri build` skips its redundant vite build. Never
# committed; local builds must always rebuild the frontend.
.vorynth-web-built

# Generated updater manifest — the CI updater-manifest job rebuilds + uploads
# this per release; it must never be committed (it fails format:check and is
# stale the moment a platform job re-uploads).
latest.json
