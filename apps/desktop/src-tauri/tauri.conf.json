{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Vorynth",
	"version": "1.8.2",
	"identifier": "com.vorynth.desktop",
	"build": {
		"beforeDevCommand": "cd ../../.. && pnpm --filter @vorynth/desktop dev",
		"devUrl": "http://localhost:5173",
		"beforeBuildCommand": "node -e \"const fs=require('fs'),p=require('path');let d=process.cwd();while(true){if(fs.existsSync(p.join(d,'pnpm-workspace.yaml'))){process.exit(fs.existsSync(p.join(d,'.vorynth-web-built'))?0:1)}const n=p.dirname(d);if(n===d){process.exit(1)}d=n}\" || pnpm --filter @vorynth/desktop build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
		"resources": ["binaries/"],
		"externalBin": [],
		"publisher": "Omid Reza Keshtkar",
		"copyright": "© 2026 Omid Reza Keshtkar",
		"createUpdaterArtifacts": true,
		"macOS": {
			"signingIdentity": "-"
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCMzFFQkFFMkExNDI0QQpSV1JLUXFIaXVoNnpEbDF4aXJuSmgyRUZYVHV6TWRHeG1Lc3pNQ1lRaFNKMDNVaThibUVSNXp0QQo=",
			"endpoints": [
				"https://github.com/omidnw/vorynth/releases/latest/download/latest.json"
			]
		}
	}
}
