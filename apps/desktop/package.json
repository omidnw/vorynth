{
	"name": "@vorynth/desktop",
	"version": "1.8.1",
	"private": true,
	"type": "module",
	"description": "Vorynth desktop frontend — React + TypeScript + Tauri.",
	"scripts": {
		"build:plugins": "node scripts/build-plugin-bundles.mjs && node scripts/build-icons-assets.mjs && node scripts/build-tech-vocab.mjs",
		"predev": "pnpm build:plugins",
		"prebuild": "pnpm build:plugins",
		"pretypecheck": "pnpm --filter @vorynth/types build && pnpm --filter @vorynth/ui build",
		"pretest": "pnpm --filter @vorynth/types build && pnpm --filter @vorynth/ui build",
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"test": "vitest run",
		"storybook": "storybook dev -p 6006",
		"storybook:build": "storybook build"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.80.0",
		"@tanstack/react-query-devtools": "^5.80.0",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-notification": "^2.3.3",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-updater": "^2.10.1",
		"@vorynth/types": "workspace:*",
		"@vorynth/ui": "workspace:*",
		"clsx": "^2.1.1",
		"dompurify": "^3.4.13",
		"html-to-image": "^1.11.11",
		"i18next": "^26.3.6",
		"iso-639-1": "^3.1.6",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-i18next": "^17.0.10",
		"react-router-dom": "^6.30.0",
		"zustand": "^5.0.5"
	},
	"devDependencies": {
		"@fontsource/geist": "^5.3.0",
		"@fontsource/inter": "^5.2.6",
		"@fontsource/jetbrains-mono": "^5.2.6",
		"@fontsource/lora": "^5.2.6",
		"@fontsource/material-symbols-outlined": "^5.3.2",
		"@fontsource/montserrat": "^5.2.6",
		"@fontsource/newsreader": "^5.2.6",
		"@fontsource/noto-sans-arabic": "^5.2.6",
		"@fontsource/noto-sans-devanagari": "^5.2.6",
		"@fontsource/noto-sans-hebrew": "^5.2.6",
		"@fontsource/noto-sans-jp": "^5.2.6",
		"@fontsource/noto-sans-kr": "^5.2.6",
		"@fontsource/noto-sans-sc": "^5.2.6",
		"@fontsource/noto-sans-thai": "^5.2.6",
		"@fontsource/open-sans": "^5.2.6",
		"@fontsource/poppins": "^5.2.6",
		"@fontsource/roboto": "^5.2.6",
		"@fontsource/vazirmatn": "^5.2.6",
		"@fortawesome/free-brands-svg-icons": "^7.1.1",
		"@fortawesome/free-solid-svg-icons": "^7.1.1",
		"@sparring/tech-catalog": "^1.0.1",
		"@storybook/react-vite": "^10.5.5",
		"@tailwindcss/container-queries": "^0.1.1",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.1.0",
		"@testing-library/user-event": "^14.5.2",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"esbuild": "^0.28.1",
		"eslint": "^9.39.1",
		"fflate": "^0.8.3",
		"jsdom": "^26.0.0",
		"lucide": "^1.28.0",
		"postcss": "^8.5.0",
		"storybook": "^10.5.5",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.9.3",
		"vite": "^6.0.7",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^4.0.13"
	}
}
