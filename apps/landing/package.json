{
	"name": "@vorynth/landing",
	"version": "1.8.0",
	"private": true,
	"type": "module",
	"description": "Vorynth landing page — Vite + React + TypeScript, built for GitHub Pages.",
	"scripts": {
		"predev": "pnpm --filter @vorynth/types build",
		"pretypecheck": "pnpm --filter @vorynth/types build",
		"pretest": "pnpm --filter @vorynth/types build",
		"prebuild": "pnpm --filter @vorynth/types build",
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"test": "vitest run"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.80.0",
		"@vorynth/types": "workspace:*",
		"@vorynth/ui": "workspace:*",
		"i18next": "^26.3.6",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-i18next": "^17.0.10",
		"react-markdown": "^10.1.0",
		"react-router-dom": "^6.30.0",
		"remark-gfm": "^4.0.1",
		"zustand": "^5.0.5"
	},
	"devDependencies": {
		"@fontsource/material-symbols-outlined": "^5.3.2",
		"@tailwindcss/container-queries": "^0.1.1",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.1.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"jsdom": "^26.0.0",
		"postcss": "^8.5.0",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.9.3",
		"vite": "^6.0.7",
		"vitest": "^4.0.13"
	}
}
